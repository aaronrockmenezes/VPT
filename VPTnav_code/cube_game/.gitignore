**/*.usd
**/*.usda
**/*.usdc
**/*.usdz
!3dpc_cam.usd
!ImageToStl_com_arrow.usd
!assets/**/*.usd
!mass_assets/**/*.usd
!source/cube_game/cube_game/tasks/direct/cube_game/*.usd

